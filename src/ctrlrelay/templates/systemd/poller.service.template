[Unit]
Description=ctrlrelay issue poller
After=network-online.target ctrlrelay-bridge.service

[Service]
Type=simple
WorkingDirectory=${WORKDIR}
# The chat token. Both the variable name and its value are
# substituted at install time: the name is whatever the active
# transport's `bot_token_env` setting says, the value comes from that
# variable in the installing shell's environment. Naming one
# provider's variable here gave every other transport a unit with no
# usable token in it, so the bridge could not log in (#267).
Environment=${TOKEN_ENV_VAR}=${TOKEN_ENV_VALUE}
# Without PYTHONUNBUFFERED, ctrlrelay's stdout sits in Python's stdio
# buffer instead of flushing line-by-line, making `tail -f` and
# `journalctl -f` lag noticeably.
Environment=PYTHONUNBUFFERED=1
# A systemd user unit gets a minimal PATH and does not read ~/.bashrc,
# so anything under ~/.local/bin is invisible to the daemon while
# working in the operator's terminal. That is #197: every code_review
# spawn failed with FileNotFoundError on the configured reviewer's
# name, which was installed under ~/.local/bin. ctrlrelay's own
# fallback search covers a unit that predates this line; a fresh
# install should not need it.
#
# A SUPERSET of what the user manager was handing us, measured from a
# live poller's /proc/<pid>/environ — including /snap/bin and the
# games directories — so rendering this unit cannot narrow the PATH of
# a machine that already works. Setting PATH here does override the
# user manager's value, so if you extend it through
# ~/.config/environment.d or `systemctl --user import-environment`,
# delete this line and let that win; the fallback search still covers
# the two binaries ctrlrelay spawns.
Environment=PATH=${HOME}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin
ExecStart=${CTRLRELAY_BIN} poller start --foreground --interval ${POLLER_INTERVAL}
Restart=always
RestartSec=5
# Give the in-process scheduler time to drain a running secops sweep
# on stop (worktree cleanup can take ~120s). systemd's default
# TimeoutStopSec is 90s, which would SIGKILL the poller mid-cleanup
# and leak git worktree admin state.
TimeoutStopSec=180
StandardOutput=append:%h/.ctrlrelay/logs/poller.log
StandardError=append:%h/.ctrlrelay/logs/poller.error.log

[Install]
WantedBy=default.target
